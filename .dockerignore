# Docker ignore file for LLM-Enhanced Trading System
# Optimize build by excluding unnecessary files

# Git and version control
.git
.gitignore
.gitattributes

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and data directories (will be mounted as volumes)
logs/
data/
temp/
*.log

# Documentation and markdown files
*.md
docs/
documentation/

# Test files and coverage
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover
.hypothesis/

# Environment files (secrets should be set in App Runner)
.env
.env.local
.env.development
.env.test
.env.production
.env.*

# Docker files (not needed in container)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# MacOS files
.DS_Store
.AppleDouble
.LSOverride

# Windows files
desktop.ini
ehthumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~.nib

# Archive files
*.tar
*.zip
*.7z
*.rar

# Backup files
backup/
backups/
*.backup

# Node.js (if any frontend components)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Large model files or data
models/
datasets/
*.pkl
*.joblib
*.h5
*.hdf5

# Secrets and keys (should never be in image)
*.pem
*.key
*.crt
*.p12
secrets/
keys/

# Local configuration
config.local.*
settings.local.*

# Cache directories
.cache/
.npm/
.yarn/

# System files
.fuse_hidden*
.directory
.Trash-*

# Performance test results
benchmark/
performance/