# Alpaca Trading API Configuration - PAPER TRADING ONLY
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# OpenAI API (for LLM agents) - Add your key here
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (alternative LLM) - Add your key here  
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Multiple Data Source API Keys for Enhanced Market Analysis
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
FMP_API_KEY=your_fmp_api_key_here
NASDAQ_API_KEY=your_nasdaq_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Email Notification Webhooks
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx/xxxxx/
MAKE_WEBHOOK_URL=https://hook.make.com/xxxxx
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trading-notifications

# Trading Configuration - Conservative defaults
TRADING_MODE=paper
MAX_PORTFOLIO_RISK=0.01  # 1% max risk per trade
MAX_POSITION_SIZE=0.05   # 5% max position size
STOP_LOSS_PERCENT=0.03   # 3% stop loss

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_system.log