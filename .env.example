# ML4T Trading System Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ALPACA TRADING API CREDENTIALS
# =============================================================================
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading
# ALPACA_BASE_URL=https://api.alpaca.markets      # Live trading (use with caution)

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
TRADING_MODE=paper                    # paper or live
LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR
TZ=America/New_York                  # Trading timezone

# Risk Management
MAX_POSITION_SIZE=0.1                # Maximum 10% per position
MAX_PORTFOLIO_RISK=0.8               # Maximum 80% portfolio at risk
STOP_LOSS_PERCENTAGE=0.05            # 5% stop loss
TAKE_PROFIT_PERCENTAGE=0.15          # 15% take profit

# =============================================================================
# LLM API CONFIGURATION
# =============================================================================
# FinGPT Configuration (Primary - Specialized for Financial Tasks)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
FINGPT_MODEL=FinGPT/fingpt-sentiment_llama2-13b_lora
USE_FINGPT_PRIMARY=true

# OpenAI API (for enhanced sentiment analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
USE_LLAMA_FALLBACK=true

# =============================================================================
# DATA SOURCES
# =============================================================================
# SEC EDGAR API Contact Information (required for API access)
SEC_CONTACT_EMAIL=your_email@example.com
SEC_COMPANY_NAME=YourCompanyName

# Reddit API (for social sentiment)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ML4T_Trading_Bot/1.0

# Twitter API (optional)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# =============================================================================
# DATABASE AND CACHING
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                      # Leave empty if no password
CACHE_ENABLED=true

# =============================================================================
# FINRL CONFIGURATION
# =============================================================================
FINRL_MODEL_PATH=/app/models
FINRL_TRAINING_ENABLED=true
FINRL_RETRAIN_INTERVAL=7            # Retrain every 7 days
FINRL_LOOKBACK_WINDOW=252           # 1 year of trading days

# =============================================================================
# DUAL-AGENT SYSTEM (LONG + SHORT)
# =============================================================================
# Enable dual-agent system with separate long and short models
ENABLE_DUAL_AGENT_SYSTEM=false      # Set to true to enable dual-agent mode

# Model paths
LONG_MODEL_PATH=data/finrl_models   # Path to long-only trained models
SHORT_MODEL_PATH=data/finrl_models_short  # Path to short-only trained models

# Regime classification (for market regime detection)
REGIME_FAST_MA=50                   # Fast moving average period (days)
REGIME_SLOW_MA=200                  # Slow moving average period (days)
REGIME_VOLATILITY_THRESHOLD=0.02    # Volatility threshold (2%)

# Short selling controls
MAX_SHORT_EXPOSURE=0.30             # Maximum 30% total short exposure
MAX_SHORT_POSITION_SIZE=0.02        # Maximum 2% per short position

# Agent blending (for neutral market regime)
NEUTRAL_REGIME_LONG_WEIGHT=0.6      # 60% long agent in neutral regime
NEUTRAL_REGIME_SHORT_WEIGHT=0.4     # 40% short agent in neutral regime

# =============================================================================
# MONITORING AND ALERTS
# =============================================================================
# Email notifications (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=alerts@yourdomain.com

# Gmail configuration for trading notifications
GMAIL_EMAIL=your_gmail_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Notification Recipients (comma-separated email addresses)
NOTIFICATION_REBALANCE_EMAILS=your_primary_email@example.com
NOTIFICATION_DAILY_SUMMARY_EMAILS=your_primary_email@example.com,additional_email@example.com

# Slack notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Application settings
PYTHONPATH=/app
APP_ENV=production
APP_VERSION=latest
PARALLEL_PROCESSING=true

# Performance tuning
MAX_WORKERS=4
MEMORY_LIMIT=2g
CPU_LIMIT=1.0

# =============================================================================
# DEVELOPMENT SETTINGS (only for dev environment)
# =============================================================================
JUPYTER_ENABLE_LAB=yes
JUPYTER_TOKEN=                       # Leave empty for no token in dev
DEBUG_MODE=false
PROFILING_ENABLED=false