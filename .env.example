# Alpaca Trading API Configuration
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# LLM API Keys (choose at least one)
# FinGPT Configuration (Primary - Specialized for Financial Tasks)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
FINGPT_MODEL=FinGPT/fingpt-sentiment_llama2-13b_lora
USE_FINGPT_PRIMARY=true

# Fallback LLM APIs
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (local LLM fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
USE_LLAMA_FALLBACK=true

# Social Media APIs for Sentiment Analysis
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TradingBot/1.0
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=alerts@yourdomain.com

# Trading Configuration
TRADING_MODE=paper
MAX_PORTFOLIO_RISK=0.05
MAX_POSITION_SIZE=0.35
TARGET_PORTFOLIO_SIZE=35

# System Configuration
LOG_LEVEL=INFO
CACHE_ENABLED=true
PARALLEL_PROCESSING=true