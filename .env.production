# Production Environment Configuration for LLM-Enhanced Trading System
# ⚠️  IMPORTANT: This file contains example values only
# ⚠️  Set actual values in AWS App Runner configuration

# Core Application Settings
TRADING_MODE=paper
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Security Settings
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_BROWSER_XSS_FILTER=true

# Trading System Configuration
MAX_PORTFOLIO_RISK=0.05
MAX_POSITION_SIZE=0.15
STOP_LOSS_PERCENT=0.08
REBALANCE_FREQUENCY=3600
MIN_REBALANCE_THRESHOLD=0.05

# Risk Management
MAX_DAILY_TRADES=10
MAX_DAILY_LOSS=0.05
MIN_CASH_RESERVE=0.1

# LLM Configuration
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# Alpaca Trading API (Paper Trading for Safety)
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
# ALPACA_API_KEY=your_alpaca_api_key_here (Set in App Runner secrets)
# ALPACA_SECRET_KEY=your_alpaca_secret_key_here (Set in App Runner secrets)

# LLM API Keys (Set in App Runner secrets)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Data Source API Keys (Set in App Runner secrets)
ALPHA_VANTAGE_API_KEY=IFJRVK5NKPY798XB
FINNHUB_API_KEY=d1vb24hr01qqgeekhv2gd1vb24hr01qqgeekhv30
FMP_API_KEY=iwv4ZHZCs8LgOBNKNgMncDukBtuvXCFo
# NASDAQ_API_KEY=your_nasdaq_key_here
NEWS_API_KEY=6fb2e7bcb77e4ceb9b1d836e8c797232

# Email Notifications (Optional, set in App Runner secrets)
# GMAIL_EMAIL=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password
# ZAPIER_WEBHOOK_URL=your_zapier_webhook_url

# Performance and Monitoring
WORKER_PROCESSES=1
WORKER_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=65
MAX_REQUESTS=0
MAX_REQUESTS_JITTER=0

# Application Monitoring
PROMETHEUS_METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
METRICS_COLLECTION_INTERVAL=60

# Logging Configuration
LOG_FILE=/app/logs/trading_system.log
LOG_ROTATION_SIZE=100MB
LOG_RETENTION_DAYS=30